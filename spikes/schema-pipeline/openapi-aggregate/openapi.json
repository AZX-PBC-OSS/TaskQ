  "components": {
    "schemas": {
      "BatchCounterPayload": {
        "properties": {
          "n": {
            "default": 5,
            "description": "Number of child jobs",
            "maximum": 1000,
            "minimum": 1,
            "title": "N",
            "type": "integer"
          },
          "steps": {
            "default": 5,
            "description": "Steps per child",
            "maximum": 1000,
            "minimum": 1,
            "title": "Steps",
            "type": "integer"
          }
        },
        "title": "BatchCounterPayload",
        "type": "object"
      },
      "BatchFinalizerPayload": {
        "properties": {
          "batch_id": {
            "format": "uuid",
            "title": "Batch Id",
            "type": "string"
          },
          "expected": {
            "title": "Expected",
            "type": "integer"
          }
        },
        "required": [
          "batch_id",
          "expected"
        ],
        "title": "BatchFinalizerPayload",
        "type": "object"
      },
      "EmptyPayload": {
        "properties": {},
        "title": "EmptyPayload",
        "type": "object"
      },
      "WordCountPayload": {
        "properties": {
          "text": {
            "default": "TaskQ makes background jobs simple and reliable",
            "description": "Text to count words in",
            "title": "Text",
            "type": "string"
          }
        },
        "title": "WordCountPayload",
        "type": "object"
      },
      "WordCountResult": {
        "properties": {
          "word_count": {
            "title": "Word Count",
            "type": "integer"
          },
          "char_count": {
            "title": "Char Count",
            "type": "integer"
          },
          "processed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Processed At"
          }
        },
        "required": [
          "word_count",
          "char_count"
        ],
        "title": "WordCountResult",
        "type": "object"
      },
      "CounterPayload": {
        "properties": {
          "n": {
            "default": 10,
            "title": "N",
            "type": "integer"
          }
        },
        "title": "CounterPayload",
        "type": "object"
      },
      "DbLookupPayload": {
        "properties": {
          "item_id": {
            "default": 1,
            "title": "Item Id",
            "type": "integer"
          }
        },
        "title": "DbLookupPayload",
        "type": "object"
      },
      "DeduplicatedPayload": {
        "properties": {
          "key": {
            "default": "default",
            "title": "Key",
            "type": "string"
          }
        },
        "title": "DeduplicatedPayload",
        "type": "object"
      },
      "DeferredPayload": {
        "properties": {
          "delay_seconds": {
            "default": 30,
            "title": "Delay Seconds",
            "type": "integer"
          }
        },
        "title": "DeferredPayload",
        "type": "object"
      },
      "FanOutPayload": {
        "properties": {
          "items": {
            "default": [
              "a",
              "b",
              "c"
            ],
            "items": {
              "type": "string"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "title": "FanOutPayload",
        "type": "object"
      },
      "FetchPayload": {
        "properties": {
          "url": {
            "default": "https://example.com",
            "title": "Url",
            "type": "string"
          }
        },
        "title": "FetchPayload",
        "type": "object"
      },
      "FetchResult": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "body": {
            "title": "Body",
            "type": "string"
          }
        },
        "required": [
          "status",
          "body"
        ],
        "title": "FetchResult",
        "type": "object"
      },
      "FileProcessorPayload": {
        "properties": {
          "filename": {
            "default": "data.csv",
            "title": "Filename",
            "type": "string"
          },
          "rows": {
            "default": 1000,
            "title": "Rows",
            "type": "integer"
          }
        },
        "title": "FileProcessorPayload",
        "type": "object"
      },
      "FlakyPayload": {
        "properties": {
          "fail_count": {
            "default": 2,
            "title": "Fail Count",
            "type": "integer"
          }
        },
        "title": "FlakyPayload",
        "type": "object"
      },
      "ThumbnailPayload": {
        "properties": {
          "image_url": {
            "description": "Source image URL or path",
            "title": "Image Url",
            "type": "string"
          },
          "width": {
            "default": 200,
            "maximum": 2000,
            "minimum": 1,
            "title": "Width",
            "type": "integer"
          },
          "height": {
            "default": 200,
            "maximum": 2000,
            "minimum": 1,
            "title": "Height",
            "type": "integer"
          },
          "format": {
            "default": "webp",
            "description": "Output format: webp, jpeg, png",
            "title": "Format",
            "type": "string"
          }
        },
        "required": [
          "image_url"
        ],
        "title": "ThumbnailPayload",
        "type": "object"
      },
      "ThumbnailResult": {
        "properties": {
          "output_path": {
            "title": "Output Path",
            "type": "string"
