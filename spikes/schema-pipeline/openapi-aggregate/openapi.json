  "paths": {
    "/actors/batch_counter": {
      "post": {
        "operationId": "enqueue_batch_counter",
        "summary": "Enqueues N counter jobs as a single batch, then a finalizer that waits for them.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchCounterPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Job enqueued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "null"
                }
              }
            }
          }
        }
      }
    },
    "/actors/batch_finalizer": {
      "post": {
        "operationId": "enqueue_batch_finalizer",
        "summary": "Waits for all children in the batch to complete, then logs the summary.",
